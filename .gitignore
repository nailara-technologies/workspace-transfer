# Workspace files
.DS_Store
*.swp
*~

# Credentials (NEVER commit these)
.credentials
.github-token
credentials.conf

# Checkpoint files (may contain sensitive data - keep local only)
# Encrypted checkpoints (.enc) are safe to commit
context-checkpoints/*.md
!context-checkpoints/.gitkeep
!context-checkpoints/*EXAMPLE*.md
!context-checkpoints/*.enc

# Session markers (local only)
.initialized

# Protocol-7 working directory (maintained separately)
protocol-7/

# Token tracking data (local analytics only)
.token-stats.log
.current-session
visualizations/token-dashboard-current.html

# Status automation (regenerated locally)
.user/local/

# Context management (local only)
.todos/
.research/

# Dependency management cache
.deps/cache/

# Build artifacts
*.o
*.so
*.dylib

# Temporary files
/work/
*.tmp
setup.log
