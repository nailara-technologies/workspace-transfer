#!/bin/bash
#
# START-HERE: Single entry point for complete workspace setup
#
# This script handles the complete setup process:
# 1. Validates GitHub PAT environment
# 2. Clones protocol-7 (if needed)
# 3. Configures git remotes with GitHub PAT
# 4. Installs dependencies
# 5. Provides next steps
#
# Usage:
#   ./START-HERE           # Interactive setup
#   ./START-HERE --install # Auto-install dependencies
#   ./START-HERE --help    # Show help
#

set -e

# Parse arguments
AUTO_INSTALL=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --install)
            AUTO_INSTALL=true
            shift
            ;;
        --help|-h)
            echo "Usage: START-HERE [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --install   Automatically install missing dependencies"
            echo "  --help      Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Helper functions
print_section() {
    echo -e "\n${BLUE}=== $1 ===${NC}\n"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

# Header
echo -e "${BLUE}"
cat << "EOF"
╔═══════════════════════════════════════════════════════════════════╗
║                     WORKSPACE-TRANSFER SETUP                      ║
║              Complete entry point for Protocol-7 work              ║
╚═══════════════════════════════════════════════════════════════════╝
EOF
echo -e "${NC}"

# Step 1: Verify we're in workspace-transfer
print_section "Step 1: Verifying workspace location"
if [ ! -f "$SCRIPT_DIR/README.md" ] || [ ! -d "$SCRIPT_DIR/docs" ]; then
    print_error "Not in workspace-transfer directory (missing README.md or docs/)"
    exit 1
fi
print_success "In workspace-transfer repository"

# Step 2: Check GitHub PAT
print_section "Step 2: Checking GitHub PAT authentication"
if [ -z "$GITHUB_PAT" ]; then
    print_warning "GITHUB_PAT environment variable not set"
    echo ""
    echo "To set it up:"
    echo "  1. Get your token from: https://github.com/settings/tokens"
    echo "  2. Create token with 'repo' scope"
    echo "  3. Set it with:"
    echo "     export GITHUB_PAT=\"ghp_your_actual_token_here\""
    echo "     source ~/.bashrc  # or ~/.zshrc"
    echo ""
    read -p "Do you have a GitHub PAT ready? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        read -p "Enter your GITHUB_PAT: " -s GITHUB_PAT_INPUT
        echo
        export GITHUB_PAT="$GITHUB_PAT_INPUT"
        print_success "GITHUB_PAT set for this session"
    else
        print_warning "Setup will continue, but cloning protocol-7 will fail without PAT"
    fi
else
    print_success "GITHUB_PAT is set (length: ${#GITHUB_PAT} chars)"
fi

# Step 3: Configure workspace-transfer remote
print_section "Step 3: Configuring workspace-transfer remote"
cd "$SCRIPT_DIR"
if [ -n "$GITHUB_PAT" ]; then
    bin/configure-remote
else
    print_warning "Skipping remote configuration (no GITHUB_PAT)"
fi

# Step 4: Check if protocol-7 exists
print_section "Step 4: Checking protocol-7 repository"
PROTOCOL7_DIR="$SCRIPT_DIR/../protocol-7"

if [ -d "$PROTOCOL7_DIR/.git" ]; then
    print_success "protocol-7 already cloned at $PROTOCOL7_DIR"

    # Update it
    print_section "Step 5: Updating protocol-7 repository"
    cd "$PROTOCOL7_DIR"

    if [ -n "$GITHUB_PAT" ]; then
        bin/dev/configure-remote
        git pull origin base
    else
        git pull origin base || print_warning "Pull failed (may need GITHUB_PAT)"
    fi

else
    # Clone it
    print_section "Step 4b: Cloning protocol-7 repository"

    if [ -z "$GITHUB_PAT" ]; then
        print_error "Cannot clone protocol-7 without GITHUB_PAT"
        echo ""
        echo "Set your GITHUB_PAT and run this script again:"
        echo "  export GITHUB_PAT=\"ghp_...\""
        echo "  $SCRIPT_DIR/START-HERE"
        exit 1
    fi

    cd "$SCRIPT_DIR/.."

    echo "Cloning protocol-7..."
    git clone "https://${GITHUB_PAT}@github.com/nailara-technologies/protocol-7.git" protocol-7

    cd protocol-7
    git branch --show-current
    print_success "protocol-7 cloned successfully"

    # Configure remote for protocol-7
    print_section "Step 5: Configuring protocol-7 remote"
    bin/dev/configure-remote
fi

# Step 6: Check dependencies using bin/deps
print_section "Step 6: Checking dependencies"

cd "$SCRIPT_DIR"

echo "Checking dependencies using bin/deps system..."

# Check base profile first (minimal requirements)
if bin/deps check base --no-cache; then
    print_success "Base dependencies satisfied"
else
    print_warning "Some base dependencies missing"

    if [ "$AUTO_INSTALL" = true ]; then
        print_section "Installing base dependencies"
        bin/deps install base
    elif [ -t 0 ]; then
        echo ""
        read -p "Would you like to install missing base dependencies now? (y/n) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            bin/deps install base
        else
            print_warning "Skipping base dependency installation"
            echo "You can install them later with:"
            echo "  bin/deps install base"
        fi
    else
        print_warning "Running in non-interactive mode. To auto-install dependencies, use:"
        echo "  $SCRIPT_DIR/START-HERE --install"
        echo ""
        echo "Or install manually:"
        echo "  bin/deps install base"
    fi
fi

# Offer to install protocol7_full if in auto-install mode
if [ "$AUTO_INSTALL" = true ]; then
    echo ""
    print_section "Installing full Protocol-7 development environment"
    bin/deps install protocol7_full
else
    echo ""
    echo "Optional: For full Protocol-7 development environment, install with:"
    echo "  bin/deps install protocol7_full"
    echo ""
    echo "Or check available profiles:"
    echo "  bin/deps list"
fi

# Step 7: Print summary and next steps
print_section "✓ SETUP COMPLETE"

echo "Workspace Status:"
echo "  workspace-transfer: $SCRIPT_DIR"
echo "  protocol-7:         $PROTOCOL7_DIR"
echo ""

echo "What to do next:"
echo ""
echo "1. Review current priorities:"
echo "   cat STATUS.md"
echo ""
echo "2. Understand the workflow:"
echo "   cat docs/onboarding/PROTOCOL7_SETUP.md"
echo ""
echo "3. Check dependencies (optional):"
echo "   bin/deps check protocol7-full"
echo "   bin/deps install protocol7-full"
echo ""
echo "4. Start working on protocol-7:"
echo "   cd ../protocol-7"
echo "   cat STATUS.md"
echo ""
echo "5. For git operations with auto-remote configuration:"
echo "   bin/push-to-github base"
echo ""

# Show what can be started now
print_section "🚀 What You Can Start Now"

echo "Protocol-7 is ready to use! Here are some examples:"
echo ""
echo "📖 View source code (use symlink shortcut):"
echo "   p7.sourcecode"
echo ""
echo "🔑 Access key management:"
echo "   p7.keys"
echo ""
echo "🧊 Run Protocol-7 with specific Zenka:"
echo "   ./bin/Protocol-7 v7         # Run v7 zenka"
echo "   ./bin/Protocol-7 cube       # Run cube zenka"
echo ""
echo "📊 Verbose output for debugging (add flags):"
echo "   ./bin/Protocol-7 v7 -v      # Verbose (1 level)"
echo "   ./bin/Protocol-7 v7 -vv     # More verbose (2 levels)"
echo "   ./bin/Protocol-7 v7 -vvv    # Maximum verbose (3 levels)"
echo ""
echo "⚡ Use convenient symlinks (automatically set up):"
echo "   p7.v7           # Shortcut for ./bin/Protocol-7 v7"
echo "   p7.cube         # Shortcut for ./bin/Protocol-7 cube"
echo "   p7.keys         # Shortcut for key management"
echo "   p7.sourcecode   # Shortcut for source code viewer"
echo "   nshell          # Interactive shell"
echo ""
echo "📚 For documentation:"
echo "   cat docs/onboarding/PROTOCOL7_SETUP.md"
echo "   cat ../protocol-7/STATUS.md"
echo ""

# If GITHUB_PAT was set, offer to save it
if [ -n "$GITHUB_PAT" ] && [ ! -f "$HOME/.github_pat_set" ]; then
    echo "---"
    read -p "Would you like to save GITHUB_PAT to your shell profile? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        # Try to detect shell
        if [ -f "$HOME/.bashrc" ]; then
            echo "export GITHUB_PAT=\"$GITHUB_PAT\"" >> "$HOME/.bashrc"
            print_success "Added to ~/.bashrc"
        fi
        if [ -f "$HOME/.zshrc" ]; then
            echo "export GITHUB_PAT=\"$GITHUB_PAT\"" >> "$HOME/.zshrc"
            print_success "Added to ~/.zshrc"
        fi
        touch "$HOME/.github_pat_set"
    fi
fi

echo ""
print_success "Happy hacking! 🚀"
