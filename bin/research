#!/usr/bin/env perl
# Research question tracking system
# Defer investigations to keep context focused

use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/lib";
use Time::Piece;
use File::Path qw(make_path);
use File::Basename;

my $WORKSPACE_ROOT = dirname($RealBin);
my $RESEARCH_DIR = "$WORKSPACE_ROOT/.research";
my $QUESTIONS_FILE = "$RESEARCH_DIR/questions.yaml";
my $ANSWERED_DIR = "$RESEARCH_DIR/answered";

# Ensure directories exist
make_path($RESEARCH_DIR, $ANSWERED_DIR) unless -d $ANSWERED_DIR;

# Initialize empty questions file if needed
unless (-f $QUESTIONS_FILE) {
    open my $fh, '>', $QUESTIONS_FILE or die "Cannot create $QUESTIONS_FILE: $!\n";
    print $fh "# Research Questions\n# Generated by bin/research\nquestions: []\n";
    close $fh;
}

# Parse command
my $cmd = shift @ARGV || 'list';

if ($cmd eq 'ask') {
    ask_question(@ARGV);
} elsif ($cmd eq 'list' || $cmd eq 'ls') {
    list_questions(@ARGV);
} elsif ($cmd eq 'answer' || $cmd eq 'ans') {
    answer_question(@ARGV);
} elsif ($cmd eq 'defer') {
    defer_question(@ARGV);
} elsif ($cmd eq 'prioritize' || $cmd eq 'pri') {
    prioritize_question(@ARGV);
} elsif ($cmd eq 'archive') {
    archive_answered();
} elsif ($cmd eq 'show') {
    show_question(@ARGV);
} elsif ($cmd eq 'rm' || $cmd eq 'delete') {
    delete_question(@ARGV);
} elsif ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
    show_help();
} else {
    die "Unknown command: $cmd\nRun 'bin/research help' for usage.\n";
}

sub ask_question {
    my ($question, $priority) = @_;

    unless ($question) {
        die "Usage: bin/research ask \"<question>\" [priority]\n";
    }

    $priority ||= 'medium';
    unless ($priority =~ /^(blocking|high|medium|low)$/) {
        die "Invalid priority: $priority\nValid: blocking, high, medium, low\n";
    }

    my $questions = load_questions();

    # Generate unique ID
    my $id = generate_id();

    # Get current context
    my $branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null` || 'unknown';
    chomp $branch;

    # Try to detect related files from recent git activity
    my @related_files = ();
    my $recent_files = `git diff --name-only HEAD~3..HEAD 2>/dev/null`;
    if ($recent_files) {
        @related_files = grep { $_ } map { chomp; $_ } split /\n/, $recent_files;
        @related_files = @related_files[0..4] if @related_files > 5;  # Limit to 5
    }

    my $q = {
        id => $id,
        question => $question,
        priority => $priority,
        status => 'pending',
        created => time(),
        branch => $branch,
        related_files => \@related_files,
    };

    push @$questions, $q;
    save_questions($questions);

    my $emoji = priority_emoji($priority);
    print "🔬 Research question added: $emoji $question [$priority] ($id)\n";

    if (@related_files) {
        print "   📎 Related files detected: " . join(', ', @related_files[0..2]) . "\n";
    }

    # Token savings message
    print "\n💡 Context kept focused. Investigate later with:\n";
    print "   bin/research show $id\n";

    # Update status files
    system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
}

sub list_questions {
    my ($filter) = @_;

    my $questions = load_questions();

    # Filter by priority if specified
    if ($filter && $filter =~ /^(blocking|high|medium|low|pending|answered)$/) {
        if ($filter =~ /^(pending|answered)$/) {
            $questions = [grep { $_->{status} eq $filter } @$questions];
        } else {
            $questions = [grep { $_->{priority} eq $filter } @$questions];
        }
    }

    # Sort by priority then created time
    my %priority_order = (blocking => 0, high => 1, medium => 2, low => 3);
    $questions = [sort {
        ($priority_order{$a->{priority}} <=> $priority_order{$b->{priority}}) ||
        ($a->{created} <=> $b->{created})
    } @$questions];

    if (@$questions == 0) {
        print "📭 No research questions" . ($filter ? " matching '$filter'" : "") . "\n";
        return;
    }

    print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    print "RESEARCH QUESTIONS" . ($filter ? " [$filter]" : "") . "\n";
    print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

    my $current_priority = '';
    for my $q (@$questions) {
        # Print priority header
        if ($q->{priority} ne $current_priority) {
            $current_priority = $q->{priority};
            my $emoji = priority_emoji($current_priority);
            print "\n$emoji " . uc($current_priority) . ":\n";
        }

        my $status_icon = $q->{status} eq 'answered' ? '✅' : '❓';
        my $age = format_age(time() - $q->{created});

        print "  $status_icon $q->{question}\n";
        print "     ID: $q->{id} | Branch: $q->{branch} | Age: $age\n";

        if ($q->{related_files} && @{$q->{related_files}}) {
            my @files = @{$q->{related_files}};
            print "     📎 Related: " . join(', ', @files[0..2]) . "\n";
        }
    }

    print "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";

    my $pending = scalar(grep { $_->{status} eq 'pending' } @$questions);
    my $answered = scalar(grep { $_->{status} eq 'answered' } @$questions);

    print "$pending pending, $answered answered\n";

    if ($pending > 0 && !$filter) {
        print "\n💡 Tip: Investigate in dedicated session to avoid context bloat\n";
    }
}

sub answer_question {
    my ($id, $answer) = @_;

    unless ($id) {
        die "Usage: bin/research answer <id> [\"answer\"]\n";
    }

    my $questions = load_questions();
    my $found = 0;

    for my $q (@$questions) {
        if ($q->{id} eq $id) {
            $q->{status} = 'answered';
            $q->{answered} = time();
            $q->{answer} = $answer if $answer;

            print "✅ Answered: $q->{question}\n";

            if ($answer) {
                print "   💡 $answer\n";
            }

            # Suggest creating a todo if answer implies work
            my $has_todo_keywords = $answer && $answer =~ /\b(implement|create|add|fix|refactor|update)\b/i;
            if ($has_todo_keywords) {
                print "\n💡 Answer suggests work. Consider:\n";
                print "   bin/todo add \"<task based on answer>\"\n";
            }

            # Suggest archiving if multiple answered
            my $answered_count = scalar(grep { $_->{status} eq 'answered' } @$questions);
            if ($answered_count >= 3) {
                print "💡 Tip: bin/research archive  # Archive $answered_count answered question(s)\n";
            }

            $found = 1;
            last;
        }
    }

    if ($found) {
        save_questions($questions);
        system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
    } else {
        die "❌ Research question not found: $id\n";
    }
}

sub defer_question {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/research defer <id>\n";
    }

    my $questions = load_questions();
    my $found = 0;

    for my $q (@$questions) {
        if ($q->{id} eq $id) {
            $q->{priority} = 'low';
            $q->{deferred_at} = time();
            $found = 1;

            print "⏸️  Deferred: $q->{question}\n";
            last;
        }
    }

    if ($found) {
        save_questions($questions);
        system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
    } else {
        die "❌ Research question not found: $id\n";
    }
}

sub prioritize_question {
    my ($id, $new_priority) = @_;

    unless ($id && $new_priority) {
        die "Usage: bin/research prioritize <id> <priority>\n";
    }

    unless ($new_priority =~ /^(blocking|high|medium|low)$/) {
        die "Invalid priority: $new_priority\nValid: blocking, high, medium, low\n";
    }

    my $questions = load_questions();
    my $found = 0;

    for my $q (@$questions) {
        if ($q->{id} eq $id) {
            my $old = $q->{priority};
            $q->{priority} = $new_priority;
            $found = 1;

            my $emoji = priority_emoji($new_priority);
            print "$emoji Updated priority: $old → $new_priority\n";
            print "   $q->{question}\n";
            last;
        }
    }

    if ($found) {
        save_questions($questions);
    } else {
        die "❌ Research question not found: $id\n";
    }
}

sub archive_answered {
    my $questions = load_questions();
    my @answered = grep { $_->{status} eq 'answered' } @$questions;
    my @pending = grep { $_->{status} ne 'answered' } @$questions;

    if (@answered == 0) {
        print "📭 No answered questions to archive\n";
        return;
    }

    # Create archive file
    my $date = localtime->ymd;
    my $archive_file = "$ANSWERED_DIR/$date.yaml";

    # Load existing archive if present
    my @archive_questions = ();
    if (-f $archive_file) {
        my $content = do { local (@ARGV, $/) = $archive_file; <> };
        @archive_questions = parse_yaml_questions($content);
    }

    # Add newly answered
    push @archive_questions, @answered;

    # Save archive
    save_questions(\@archive_questions, $archive_file);

    # Save pending (without answered)
    save_questions(\@pending);

    print "📦 Archived " . scalar(@answered) . " answered question(s) to $archive_file\n";

    for my $q (@answered) {
        my $duration = format_age($q->{answered} - $q->{created});
        print "   ✅ $q->{question} (answered in $duration)\n";
        if ($q->{answer}) {
            print "      💡 " . substr($q->{answer}, 0, 60) . "...\n";
        }
    }
}

sub show_question {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/research show <id>\n";
    }

    my $questions = load_questions();

    for my $q (@$questions) {
        if ($q->{id} eq $id) {
            print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
            print "RESEARCH QUESTION: $q->{id}\n";
            print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

            my $emoji = priority_emoji($q->{priority});
            print "❓ $q->{question}\n\n";

            print "Priority:  $q->{priority} $emoji\n";
            print "Status:    $q->{status}\n";
            print "Branch:    $q->{branch}\n";
            print "Created:   " . localtime($q->{created})->datetime . "\n";
            print "Age:       " . format_age(time() - $q->{created}) . "\n";

            if ($q->{answered}) {
                print "Answered:  " . localtime($q->{answered})->datetime . "\n";
                print "Duration:  " . format_age($q->{answered} - $q->{created}) . "\n";
            }

            if ($q->{related_files} && @{$q->{related_files}}) {
                print "\n📎 Related files:\n";
                for my $file (@{$q->{related_files}}) {
                    print "   - $file\n";
                }
            }

            if ($q->{answer}) {
                print "\n💡 Answer:\n";
                print wrap_text($q->{answer}, 3);
                print "\n";
            }

            print "\n";
            return;
        }
    }

    die "❌ Research question not found: $id\n";
}

sub delete_question {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/research rm <id>\n";
    }

    my $questions = load_questions();
    my $original_count = scalar(@$questions);

    $questions = [grep { $_->{id} ne $id } @$questions];

    if (scalar(@$questions) == $original_count) {
        die "❌ Research question not found: $id\n";
    }

    save_questions($questions);
    print "🗑️  Deleted research question: $id\n";

    system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
}

sub show_help {
    print <<'HELP';
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RESEARCH - Question Tracking System
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE:
  bin/research <command> [args]

COMMANDS:
  ask <question> [priority]   Add research question (priority: blocking|high|medium|low)
  list [filter]               List questions (filter: priority or status)
  answer <id> ["answer"]      Mark question as answered with optional answer
  defer <id>                  Defer question (low priority)
  prioritize <id> <priority>  Change question priority
  archive                     Archive answered questions
  show <id>                   Show question details
  rm <id>                     Delete question
  help                        Show this help

EXAMPLES:
  bin/research ask "How does the resonant pair generation work?" high
  bin/research list blocking
  bin/research answer r-20251107-010000 "Uses BMW pattern matching"
  bin/research defer r-20251107-010001
  bin/research archive

PRIORITIES:
  🔴 blocking  - Blocks current work, must answer now
  🟠 high      - Important, answer soon
  🟡 medium    - Normal curiosity (default)
  🟢 low       - Nice to know eventually

PHILOSOPHY:
  Questions arise during work. Exploring immediately bloats context.
  Instead, track the question and investigate in a dedicated session.

  This keeps the current context laser-focused on the task at hand.

FILES:
  .research/questions.yaml       Active questions (local only, gitignored)
  .research/answered/YYYY-MM-DD  Archived answered questions

TOKEN SAVINGS:
  - Per deferred question: ~300-1000 tokens (not exploring immediately)
  - Focused investigation: ~1000-2000 tokens (pre-loaded context)
  - Compound over 100 sessions: ~30k-100k tokens

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
HELP
}

# Helper functions

sub load_questions {
    my $file = shift || $QUESTIONS_FILE;
    return [] unless -f $file;

    my $content = do { local (@ARGV, $/) = $file; <> };
    return parse_yaml_questions($content);
}

sub parse_yaml_questions {
    my ($content) = @_;

    my @questions;
    my $current = undef;

    for my $line (split /\n/, $content) {
        next if $line =~ /^#/ || $line =~ /^\s*$/;
        next if $line =~ /^questions:/;

        if ($line =~ /^\s*-\s+id:\s*(.+)/) {
            $current = { id => $1 };
            push @questions, $current;
        } elsif ($current && $line =~ /^\s+(\w+):\s*(.+)/) {
            my ($key, $val) = ($1, $2);
            $val =~ s/^["'](.*)["']$/$1/;  # Remove quotes

            if ($key eq 'related_files') {
                # Parse array
                $val =~ s/^\[|\]$//g;
                my @files = map { s/^\s+|\s+$//gr; s/^["']|["']$//gr } split /,/, $val;
                $current->{$key} = \@files;
            } else {
                $current->{$key} = $val;
            }
        }
    }

    return \@questions;
}

sub save_questions {
    my ($questions, $file) = @_;
    $file ||= $QUESTIONS_FILE;

    open my $fh, '>', $file or die "Cannot write $file: $!\n";

    print $fh "# Research Questions\n";
    print $fh "# Generated by bin/research at " . localtime->datetime . "\n";
    print $fh "questions:\n";

    for my $q (@$questions) {
        print $fh "  - id: $q->{id}\n";
        print $fh "    question: \"$q->{question}\"\n";
        print $fh "    priority: $q->{priority}\n";
        print $fh "    status: $q->{status}\n";
        print $fh "    created: $q->{created}\n";
        print $fh "    branch: $q->{branch}\n";

        if ($q->{related_files} && @{$q->{related_files}}) {
            print $fh "    related_files: [" . join(', ', map { "\"$_\"" } @{$q->{related_files}}) . "]\n";
        }

        print $fh "    answered: $q->{answered}\n" if $q->{answered};
        print $fh "    answer: \"$q->{answer}\"\n" if $q->{answer};
        print $fh "    deferred_at: $q->{deferred_at}\n" if $q->{deferred_at};
    }

    close $fh;
}

sub generate_id {
    my $t = localtime;
    return 'r-' . $t->ymd('') . '-' . $t->hms('');
}

sub priority_emoji {
    my ($priority) = @_;
    return '🔴' if $priority eq 'blocking';
    return '🟠' if $priority eq 'high';
    return '🟡' if $priority eq 'medium';
    return '🟢' if $priority eq 'low';
    return '❓';
}

sub format_age {
    my ($seconds) = @_;

    my $days = int($seconds / 86400);
    my $hours = int(($seconds % 86400) / 3600);
    my $mins = int(($seconds % 3600) / 60);

    return "${days}d ${hours}h" if $days > 0;
    return "${hours}h ${mins}m" if $hours > 0;
    return "${mins}m";
}

sub wrap_text {
    my ($text, $indent) = @_;
    $indent ||= 0;
    my $prefix = ' ' x $indent;

    my @lines = split /\n/, $text;
    return join("\n", map { "$prefix$_" } @lines) . "\n";
}
