#!/usr/bin/env perl
# Dependency management system
# Pre-flight checks and one-command installation by session type

use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec;
use File::Path qw(make_path);
use Cwd qw(abs_path);
use English;

$OUTPUT_AUTOFLUSH = 1;

# Color palette inspired by Nailara branding
my $reset             = "\e[0m";
my $blacklight        = "\e[38;2;68;39;172m";    # Dark purple
my $nailara_fg        = "\e[38;2;38;46;153m";    # Dark blue
my $TRUE_color        = "\e[38;2;6;71;195m";     # Bright blue
my $NEON_orange       = "\e[38;2;197;141;7m";    # Bright orange
my $NEON_green_yellow = "\e[38;2;71;195;6m";     # Green-yellow

##[ PROJECT PATH DISCOVERY ]######################################################

# Helper functions for path operations (inspired by amos-chksum)
sub catdir  { File::Spec->catdir(@_) }
sub rel2abs { File::Spec->rel2abs(@_) }

# Discover workspace-transfer root path using FindBin
my $up_dir = File::Spec->updir;
my $WORKSPACE_ROOT = abs_path(rel2abs(catdir($RealBin, $up_dir)));

# Discover sibling directories (workspace-transfer and protocol-7 are siblings)
my $PARENT_DIR = abs_path(catdir($WORKSPACE_ROOT, $up_dir));
my $PROTOCOL7_ROOT = catdir($PARENT_DIR, 'protocol-7');

# Build all necessary paths
my $DEPS_DIR = catdir($WORKSPACE_ROOT, '.deps');
my $PROFILES_FILE = File::Spec->catfile($DEPS_DIR, 'profiles.yaml');
my $CACHE_DIR = catdir($DEPS_DIR, 'cache');

# Ensure cache directory exists
make_path($CACHE_DIR) unless -d $CACHE_DIR;

# Parse command
my $cmd = shift @ARGV || 'help';

if ($cmd eq 'check') {
    check_profile(@ARGV);
} elsif ($cmd eq 'install') {
    install_profile(@ARGV);
} elsif ($cmd eq 'list') {
    list_profiles();
} elsif ($cmd eq 'status') {
    status_all();
} elsif ($cmd eq 'clear-cache') {
    clear_cache();
} elsif ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
    show_help();
} else {
    die "Unknown command: $cmd\nRun 'bin/deps help' for usage.\n";
}

sub check_profile {
    my ($profile_name, $opts) = @_;

    unless ($profile_name) {
        die "Usage: bin/deps check <profile> [--no-cache]\n";
    }

    my $use_cache = !($opts && $opts eq '--no-cache');

    # Check cache first
    if ($use_cache) {
        my $cached = check_cache($profile_name);
        if (defined $cached) {
            if ($cached) {
                print "✅ $profile_name: All dependencies installed (cached)\n";
                return 0;
            } else {
                print "❌ $profile_name: Missing dependencies (cached - use --no-cache to recheck)\n";
                return 1;
            }
        }
    }

    # Load profile
    my $profiles = load_profiles();
    unless (exists $profiles->{$profile_name}) {
        die "❌ Unknown profile: $profile_name\nRun 'bin/deps list' to see available profiles.\n";
    }

    my $profile = $profiles->{$profile_name};

    print "🔍 Checking dependencies for: $profile_name\n";
    print "   $profile->{description}\n\n";

    # Handle includes
    if ($profile->{includes}) {
        print "📦 Profile includes: " . join(', ', @{$profile->{includes}}) . "\n\n";
        my $all_ok = 1;
        for my $included (@{$profile->{includes}}) {
            my $result = check_profile($included, '--no-cache');
            $all_ok = 0 if $result != 0;
        }
        update_cache($profile_name, $all_ok);
        return $all_ok ? 0 : 1;
    }

    my @missing;
    my $total = 0;

    # Check APT packages
    if ($profile->{apt}) {
        print "Checking APT packages...\n";
        for my $pkg (@{$profile->{apt}}) {
            $total++;
            if (check_apt($pkg)) {
                print "  ✅ $pkg\n";
            } else {
                print "  ❌ $pkg (missing)\n";
                push @missing, "apt:$pkg";
            }
        }
        print "\n";
    }

    # Check CPAN modules
    if ($profile->{cpan}) {
        print "Checking CPAN modules...\n";
        for my $module (@{$profile->{cpan}}) {
            $total++;
            if (check_cpan($module)) {
                print "  ✅ $module\n";
            } else {
                print "  ❌ $module (missing)\n";
                push @missing, "cpan:$module";
            }
        }
        print "\n";
    }

    # Check CPAN fallback modules (preferred via APT)
    if ($profile->{cpan_fallback}) {
        my %fallback_map = (
            'AnyEvent' => 'libanyevent-perl',
            'BSD::Resource' => 'libbsd-resource-perl',
            'Cairo' => 'libcairo-perl',
            'Cairo::GObject' => 'libcairo-gobject-perl',
            'Capture::Tiny' => 'libcapture-tiny-perl',
            'Clone' => 'libclone-perl',
            'Const::Fast' => 'libconst-fast-perl',
            'Convert::Color' => 'libconvert-color-perl',
            'Crypt::Digest::MD5' => 'libcryptx-perl',
            'Crypt::Digest::SHA1' => 'libcryptx-perl',
            'Crypt::Misc' => 'libcryptx-perl',
            'Crypt::PRNG::Fortuna' => 'libcryptx-perl',
            'CryptX' => 'libcryptx-perl',
            'Digest::CRC' => 'libdigest-crc-perl',
            'Digest::Elf' => 'libdigest-elf-perl',
        );
        print "Checking CPAN fallback modules (via APT or CPAN)...\n";
        for my $module (@{$profile->{cpan_fallback}}) {
            $total++;
            my $apt_pkg = $fallback_map{$module};
            my $via_apt = $apt_pkg && check_apt($apt_pkg);

            if (check_cpan($module)) {
                if ($via_apt) {
                    print "  ✅ $module (via APT: $apt_pkg)\n";
                } else {
                    print "  ✅ $module (via CPAN)\n";
                }
            } else {
                print "  ❌ $module (missing)\n";
                push @missing, "cpan_fallback:$module";
            }
        }
        print "\n";
    }

    # Check system commands
    if ($profile->{system}) {
        print "Checking system commands...\n";
        for my $cmd (@{$profile->{system}}) {
            $total++;
            if (check_command($cmd)) {
                print "  ✅ $cmd\n";
            } else {
                print "  ❌ $cmd (missing)\n";
                push @missing, "system:$cmd";
            }
        }
        print "\n";
    }

    # Summary
    my $ok = @missing == 0;
    if ($ok) {
        print "✅ All dependencies installed ($total/$total)\n";
        update_cache($profile_name, 1);
        return 0;
    } else {
        print "❌ Missing " . scalar(@missing) . " dependencies\n";
        print "\n💡 Install with: bin/deps install $profile_name\n";
        update_cache($profile_name, 0);
        return 1;
    }
}

sub install_profile {
    my ($profile_name, $opts) = @_;

    unless ($profile_name) {
        die "Usage: bin/deps install <profile> [--dry-run]\n";
    }

    my $dry_run = ($opts && $opts eq '--dry-run');

    # Load profile
    my $profiles = load_profiles();
    unless (exists $profiles->{$profile_name}) {
        die "❌ Unknown profile: $profile_name\nRun 'bin/deps list' to see available profiles.\n";
    }

    my $profile = $profiles->{$profile_name};

    print "📦 Installing dependencies for: $profile_name\n";
    print "   $profile->{description}\n\n";

    if ($dry_run) {
        print "🔍 DRY RUN - No actual installation\n\n";
    }

    # Handle includes
    if ($profile->{includes}) {
        print "📦 Profile includes: " . join(', ', @{$profile->{includes}}) . "\n\n";
        for my $included (@{$profile->{includes}}) {
            install_profile($included, $opts);
        }
        return;
    }

    my @apt_packages;
    my @cpan_modules;

    # Collect missing packages
    if ($profile->{apt}) {
        for my $pkg (@{$profile->{apt}}) {
            unless (check_apt($pkg)) {
                push @apt_packages, $pkg;
            }
        }
    }

    if ($profile->{cpan}) {
        for my $module (@{$profile->{cpan}}) {
            unless (check_cpan($module)) {
                push @cpan_modules, $module;
            }
        }
    }

    # Handle cpan_fallback - only install if APT equivalent isn't available
    if ($profile->{cpan_fallback}) {
        # Map fallback modules to APT packages
        my %fallback_map = (
            'AnyEvent' => 'libanyevent-perl',
            'BSD::Resource' => 'libbsd-resource-perl',
            'Cairo' => 'libcairo-perl',
            'Cairo::GObject' => 'libcairo-gobject-perl',
            'Capture::Tiny' => 'libcapture-tiny-perl',
            'Clone' => 'libclone-perl',
            'Const::Fast' => 'libconst-fast-perl',
            'Convert::Color' => 'libconvert-color-perl',
            'Crypt::Digest::MD5' => 'libcryptx-perl',
            'Crypt::Digest::SHA1' => 'libcryptx-perl',
            'Crypt::Misc' => 'libcryptx-perl',
            'Crypt::PRNG::Fortuna' => 'libcryptx-perl',
            'CryptX' => 'libcryptx-perl',
            'Digest::CRC' => 'libdigest-crc-perl',
            'Digest::Elf' => 'libdigest-elf-perl',
        );

        for my $module (@{$profile->{cpan_fallback}}) {
            my $apt_pkg = $fallback_map{$module};

            if ($apt_pkg) {
                # Check if APT package is installed and module is loadable
                if (check_apt($apt_pkg) && check_cpan($module)) {
                    # APT package provides this, no need for CPAN
                    next;
                }
            }

            # Either no APT package or module not available from APT, try CPAN
            unless (check_cpan($module)) {
                push @cpan_modules, $module;
            }
        }
    }

    # Install APT packages
    if (@apt_packages) {
        print "📥 Installing APT packages: " . join(', ', @apt_packages) . "\n";

        if ($dry_run) {
            my $sudo = get_sudo();
            print "   [DRY RUN] Would run: ${sudo}apt-get install -y " . join(' ', @apt_packages) . "\n\n";
        } else {
            my $sudo = get_sudo();
            my $cmd = "${sudo}apt-get update -qq && ${sudo}apt-get install -y " . join(' ', @apt_packages);
            print "   Running: $cmd\n";

            my $result = system($cmd);
            if ($result == 0) {
                print "   ✅ APT packages installed\n\n";
            } else {
                print "   ❌ APT installation failed (exit code: $result)\n\n";
            }
        }
    }

    # Install CPAN modules
    if (@cpan_modules) {
        print "📥 Installing CPAN modules: " . join(', ', @cpan_modules) . "\n";

        # Prefer cpanm (from cpanminus package), fall back to cpan
        my $cpan_cmd = `which cpanm 2>/dev/null` ? 'cpanm' : 'cpan';

        if ($dry_run) {
            print "   [DRY RUN] Would run: $cpan_cmd " . join(' ', @cpan_modules) . "\n\n";
        } else {
            for my $module (@cpan_modules) {
                print "   Installing $module...\n";

                my $cmd = ($cpan_cmd eq 'cpanm')
                    ? "$cpan_cmd -n $module"
                    : "cpan -T $module 2>&1 | grep -v 'Loading internal'";

                my $result = system($cmd);

                if ($result == 0) {
                    print "   ✅ $module installed\n";
                } else {
                    print "   ❌ $module installation failed\n";
                }
            }
            print "\n";
        }
    }

    if (@apt_packages == 0 && @cpan_modules == 0) {
        print "✅ All dependencies already installed\n\n";
    }

    # Run setup operations (copy files, create symlinks, execute commands)
    copy_files($profile_name, $profile, $dry_run);
    create_symlinks($profile_name, $profile, $dry_run);
    setup_paths($profile_name, $profile, $dry_run);
    execute_commands($profile_name, $profile, $dry_run);

    # Clear cache to force recheck
    clear_cache_for($profile_name);

    unless ($dry_run) {
        print "💡 Verify installation: bin/deps check $profile_name --no-cache\n";
    }
}

sub list_profiles {
    my $profiles = load_profiles();

    print "${blacklight}:$reset\n";
    print "${blacklight}::[$TRUE_color AVAILABLE DEPENDENCY PROFILES $blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    for my $name (sort keys %$profiles) {
        my $profile = $profiles->{$name};
        print "${blacklight}::$reset ${NEON_green_yellow}$name$reset\n";
        print "${blacklight}::$reset   $profile->{description}\n";

        if ($profile->{includes}) {
            print "${blacklight}::$reset   Includes: ${NEON_orange}" . join(', ', @{$profile->{includes}}) . "$reset\n";
        } else {
            my @types;
            push @types, scalar(@{$profile->{apt}}) . " apt" if $profile->{apt};
            push @types, scalar(@{$profile->{cpan}}) . " cpan" if $profile->{cpan};
            push @types, scalar(@{$profile->{system}}) . " system" if $profile->{system};
            print "${blacklight}::$reset   Packages: ${NEON_orange}" . join(', ', @types) . "$reset\n" if @types;
        }
        print "\n";
    }

    print "${blacklight}:$reset\n";
    print "${blacklight}::[$TRUE_color USAGE$blacklight]$reset\n";
    print "${blacklight}::$reset   bin/deps check <profile>       # Check if dependencies are installed\n";
    print "${blacklight}::$reset   bin/deps install <profile>     # Install missing dependencies\n";
    print "${blacklight}::$reset   bin/deps status                # Check all profiles\n";
    print "${blacklight}:$reset\n";
}

sub status_all {
    my $profiles = load_profiles();

    print "${blacklight}:$reset\n";
    print "${blacklight}::[$TRUE_color DEPENDENCY STATUS $blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    for my $name (sort keys %$profiles) {
        next if $name eq 'development';  # Skip meta-profile

        print "Checking ${NEON_green_yellow}$name$reset...\n";
        check_profile($name);
        print "\n";
    }

    print "${blacklight}:$reset\n";
}

sub clear_cache {
    if (-d $CACHE_DIR) {
        system("rm -rf $CACHE_DIR/*");
        print "🗑️  Cache cleared\n";
    }
}

sub clear_cache_for {
    my ($profile) = @_;
    my $cache_file = File::Spec->catfile($CACHE_DIR, "$profile.cache");
    unlink $cache_file if -f $cache_file;
}

sub show_help {
    print "${blacklight}:$reset\n";
    print "${blacklight}::[$TRUE_color DEPS - Dependency Management System$blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    print "${blacklight}::[$NEON_orange USAGE$blacklight]$reset\n";
    print "${blacklight}::$reset   bin/deps <command> [args]\n\n";

    print "${blacklight}::[$NEON_orange COMMANDS$blacklight]$reset\n";
    print "${blacklight}::$reset   check <profile> [--no-cache]    Check if dependencies are installed\n";
    print "${blacklight}::$reset   install <profile> [--dry-run]   Install missing dependencies\n";
    print "${blacklight}::$reset   list                            List available profiles\n";
    print "${blacklight}::$reset   status                          Check all profiles\n";
    print "${blacklight}::$reset   clear-cache                     Clear verification cache\n";
    print "${blacklight}::$reset   help                            Show this help\n\n";

    print "${blacklight}::[$NEON_orange PROFILES$blacklight]$reset\n";
    print "${blacklight}::$reset   base           Basic workspace dependencies\n";
    print "${blacklight}::$reset   filesystem     FUSE filesystem development\n";
    print "${blacklight}::$reset   network        Network distribution protocol\n";
    print "${blacklight}::$reset   learning       Learning system with SQLite\n";
    print "${blacklight}::$reset   visualization  Token visualization and graphing\n";
    print "${blacklight}::$reset   archive        Archive system with compression\n";
    print "${blacklight}::$reset   development    Full development environment (all profiles)\n\n";

    print "${blacklight}::[$NEON_orange EXAMPLES$blacklight]$reset\n";
    print "${blacklight}::$reset   bin/deps list                    # List all profiles\n";
    print "${blacklight}::$reset   bin/deps check visualization     # Check visualization deps\n";
    print "${blacklight}::$reset   bin/deps install filesystem      # Install filesystem deps\n";
    print "${blacklight}::$reset   bin/deps install base --dry-run  # Preview installation\n";
    print "${blacklight}::$reset   bin/deps status                  # Check all profiles\n\n";

    print "${blacklight}::[$NEON_orange CACHING$blacklight]$reset\n";
    print "${blacklight}::$reset   Dependency checks are cached for performance. Use --no-cache to force recheck.\n";
    print "${blacklight}::$reset   Clear cache with: bin/deps clear-cache\n\n";

    print "${blacklight}::[$NEON_orange FILES$blacklight]$reset\n";
    print "${blacklight}::$reset   .deps/profiles.yaml    Dependency definitions\n";
    print "${blacklight}::$reset   .deps/cache/           Verification cache (gitignored)\n\n";

    print "${blacklight}::[$NEON_orange PROFILE SECTIONS$blacklight]$reset\n";
    print "${blacklight}::$reset   description  Short description of the profile\n";
    print "${blacklight}::$reset   apt          APT packages to install\n";
    print "${blacklight}::$reset   cpan         Perl CPAN modules to install\n";
    print "${blacklight}::$reset   system       System commands to verify\n";
    print "${blacklight}::$reset   copy         Files to copy (src, dest, sudo)\n";
    print "${blacklight}::$reset   symlinks     Symlinks to create (target, link, sudo)\n";
    print "${blacklight}::$reset   paths        Directories to add to PATH\n";
    print "${blacklight}::$reset   exec         Commands to execute post-install (cmd, sudo)\n\n";

    print "${blacklight}::[$NEON_orange SETUP OPERATIONS$blacklight]$reset\n";
    print "${blacklight}::$reset   All profiles support setup operations that run after dependency installation:\n";
    print "${blacklight}::$reset   - Copy files (with automatic sudo when needed)\n";
    print "${blacklight}::$reset   - Create symlinks (with automatic sudo when needed)\n";
    print "${blacklight}::$reset   - Print PATH instructions\n";
    print "${blacklight}::$reset   - Execute post-install commands (systemd reload, etc.)\n\n";

    print "${blacklight}::[$NEON_orange ROOT DETECTION$blacklight]$reset\n";
    print "${blacklight}::$reset   Sudo is automatically skipped when running as root user.\n\n";

    print "${blacklight}::[$NEON_orange CPAN TOOL$blacklight]$reset\n";
    print "${blacklight}::$reset   Prefers cpanm (from cpanminus package) for reliable module installation.\n";
    print "${blacklight}::$reset   Falls back to cpan if cpanm is not available.\n";
    print "${blacklight}::$reset   For best results, ensure cpanminus is installed.\n\n";

    print "${blacklight}::[$NEON_orange PATH DISCOVERY$blacklight]$reset\n";
    print "${blacklight}::$reset   Uses FindBin-based absolute path discovery for reliable operation\n";
    print "${blacklight}::$reset   from any working directory. Workspace root detected automatically.\n\n";

    print "${blacklight}:$reset\n";
}

# Helper functions

sub is_root {
    return $> == 0;
}

sub get_sudo {
    return is_root() ? '' : 'sudo ';
}

sub load_profiles {
    my %profiles;

    open my $fh, '<', $PROFILES_FILE or die "Cannot read $PROFILES_FILE: $!\n";

    my $current_profile = undef;
    my $current_section = undef;
    my $current_obj = undef;

    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^#/ || $line =~ /^\s*$/;
        next if $line =~ /^profiles:/;

        if ($line =~ /^  (\w+):$/) {
            # New profile
            $current_profile = $1;
            $profiles{$current_profile} = {};
            $current_obj = undef;
        } elsif ($current_profile && $line =~ /^    (\w+):\s*(.*)$/) {
            my ($key, $val) = ($1, $2);

            if ($key eq 'description') {
                $val =~ s/^"(.*)"$/$1/;
                $profiles{$current_profile}{description} = $val;
            } elsif ($key =~ /^(includes|apt|cpan|system|copy|symlinks|paths|exec)$/) {
                $current_section = $key;
                $profiles{$current_profile}{$key} = [];
                $current_obj = undef;
            }
        } elsif ($current_profile && $current_section && $line =~ /^      - (.*)$/) {
            # New list item
            my $item = $1;

            if ($current_section =~ /^(copy|symlinks|exec)$/) {
                # These are complex objects, start a new hash
                $current_obj = {};
                push @{$profiles{$current_profile}{$current_section}}, $current_obj;

                # Parse inline key:value if present (e.g., "- src: ...")
                if ($item =~ /^(\w+):\s*(.*)$/) {
                    my ($obj_key, $obj_val) = ($1, $2);
                    $obj_val =~ s/^"(.*)"$/$1/;
                    $current_obj->{$obj_key} = $obj_val;
                }
            } else {
                # Simple list items (apt, cpan, system, paths, includes)
                $item =~ s/^"(.*)"$/$1/;  # Remove quotes if present
                push @{$profiles{$current_profile}{$current_section}}, $item;
                $current_obj = undef;
            }
        } elsif ($current_profile && $current_section && $line =~ /^        (\w+):\s*(.*)$/) {
            # Handle nested properties in complex objects
            if ($current_obj && ref($current_obj) eq 'HASH') {
                my ($obj_key, $obj_val) = ($1, $2);
                $obj_val =~ s/^"(.*)"$/$1/;
                $obj_val =~ s/^([a-z]+)$/$1/;  # Handle boolean-like values
                $current_obj->{$obj_key} = $obj_val;
            }
        }
    }

    close $fh;

    return \%profiles;
}

sub check_apt {
    my ($package) = @_;
    my $result = `dpkg -l $package 2>/dev/null | grep -q '^ii' && echo 'installed'`;
    return $result =~ /installed/;
}

sub check_cpan {
    my ($module) = @_;
    my $result = system("perl -M$module -e 1 2>/dev/null");
    return $result == 0;
}

sub check_command {
    my ($cmd) = @_;
    my $result = `which $cmd 2>/dev/null`;
    return $result ne '';
}

sub check_cache {
    my ($profile) = @_;
    my $cache_file = File::Spec->catfile($CACHE_DIR, "$profile.cache");

    return undef unless -f $cache_file;

    # Check if cache is fresh (< 24 hours old)
    my $age = time() - (stat($cache_file))[9];
    return undef if $age > 86400;  # 24 hours

    open my $fh, '<', $cache_file or return undef;
    my $status = <$fh>;
    close $fh;

    chomp $status if defined $status;
    return $status eq 'OK' ? 1 : 0;
}

sub update_cache {
    my ($profile, $ok) = @_;
    my $cache_file = File::Spec->catfile($CACHE_DIR, "$profile.cache");

    open my $fh, '>', $cache_file or return;
    print $fh $ok ? 'OK' : 'MISSING';
    close $fh;
}

sub copy_files {
    my ($profile_name, $profile, $dry_run) = @_;

    return unless $profile->{copy};

    print "📋 Copying system files...\n";

    for my $copy_item (@{$profile->{copy}}) {
        my $src = $copy_item->{src};
        my $dest = $copy_item->{dest};
        my $needs_sudo = $copy_item->{sudo};

        # Resolve relative paths from workspace root
        my $full_src = File::Spec->file_name_is_absolute($src) ? $src
                     : File::Spec->catfile($WORKSPACE_ROOT, $src);

        unless (-f $full_src) {
            print "   ❌ Source not found: $full_src\n";
            next;
        }

        my $sudo_prefix = ($needs_sudo && !is_root()) ? 'sudo ' : '';

        if ($dry_run) {
            print "   [DRY RUN] Would copy: $full_src -> $dest\n";
        } else {
            my $cmd = "${sudo_prefix}cp $full_src $dest";
            print "   Copying: $full_src -> $dest\n";
            my $result = system($cmd);
            if ($result == 0) {
                print "   ✅ Copied: $dest\n";
            } else {
                print "   ❌ Failed to copy: $dest\n";
            }
        }
    }
    print "\n";
}

sub create_symlinks {
    my ($profile_name, $profile, $dry_run) = @_;

    return unless $profile->{symlinks};

    print "🔗 Creating symlinks...\n";

    for my $link_item (@{$profile->{symlinks}}) {
        my $target = $link_item->{target};
        my $link = $link_item->{link};
        my $needs_sudo = $link_item->{sudo};

        # Resolve symlink target path
        # Try workspace-transfer first, then protocol-7 (sibling directory)
        my $full_target;
        if (File::Spec->file_name_is_absolute($target)) {
            $full_target = $target;
        } else {
            my $ws_target = catdir($WORKSPACE_ROOT, $target);
            my $p7_target = catdir($PROTOCOL7_ROOT, $target);

            # Prefer workspace-transfer location, fall back to protocol-7
            if (-e $ws_target) {
                $full_target = $ws_target;
            } elsif (-e $p7_target) {
                $full_target = $p7_target;
            } else {
                # Default to workspace path (may be created later)
                $full_target = $ws_target;
            }
        }

        my $sudo_prefix = ($needs_sudo && !is_root()) ? 'sudo ' : '';

        if ($dry_run) {
            print "   [DRY RUN] Would link: $link -> $full_target\n";
        } else {
            my $cmd = "${sudo_prefix}ln -f -s $full_target $link";
            print "   Creating: $link -> $full_target\n";
            my $result = system($cmd);
            if ($result == 0) {
                print "   ✅ Symlink created: $link\n";
            } else {
                print "   ❌ Failed to create symlink: $link\n";
            }
        }
    }
    print "\n";
}

sub setup_paths {
    my ($profile_name, $profile, $dry_run) = @_;

    return unless $profile->{paths};

    print "🛣️  Adding to PATH...\n";

    my @paths = @{$profile->{paths}};
    for my $path (@paths) {
        my $full_path = File::Spec->file_name_is_absolute($path) ? $path
                      : File::Spec->catfile($WORKSPACE_ROOT, $path);

        print "   Path: $full_path\n";
    }

    print "   💡 To add these permanently, add to your shell profile:\n";
    for my $path (@paths) {
        my $full_path = File::Spec->file_name_is_absolute($path) ? $path
                      : File::Spec->catfile($WORKSPACE_ROOT, $path);
        print "      export PATH=\"$full_path:\$PATH\"\n";
    }
    print "\n";
}

sub execute_commands {
    my ($profile_name, $profile, $dry_run) = @_;

    return unless $profile->{exec};

    print "⚙️  Executing post-install commands...\n";

    for my $exec_item (@{$profile->{exec}}) {
        my $cmd = $exec_item->{cmd};
        my $needs_sudo = $exec_item->{sudo};

        my $sudo_prefix = ($needs_sudo && !is_root()) ? 'sudo ' : '';
        my $full_cmd = $sudo_prefix . $cmd;

        if ($dry_run) {
            print "   [DRY RUN] Would run: $full_cmd\n";
        } else {
            print "   Running: $full_cmd\n";
            my $result = system($full_cmd);
            if ($result == 0) {
                print "   ✅ Command executed\n";
            } else {
                print "   ⚠️  Command exit code: $result\n";
            }
        }
    }
    print "\n";
}
