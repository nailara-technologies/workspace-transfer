#!/usr/bin/env perl
# Persistent todo management system
# Token-efficient task tracking across sessions

use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/lib";
use Time::Piece;
use File::Path qw(make_path);
use File::Basename;

my $WORKSPACE_ROOT = dirname($RealBin);
my $TODO_DIR = "$WORKSPACE_ROOT/.todos";
my $ACTIVE_FILE = "$TODO_DIR/active.yaml";
my $ARCHIVE_DIR = "$TODO_DIR/archive";

# Ensure directories exist
make_path($TODO_DIR, $ARCHIVE_DIR) unless -d $ARCHIVE_DIR;

# Initialize empty active file if needed
unless (-f $ACTIVE_FILE) {
    open my $fh, '>', $ACTIVE_FILE or die "Cannot create $ACTIVE_FILE: $!\n";
    print $fh "# Active Todos\n# Generated by bin/todo\ntodos: []\n";
    close $fh;
}

# Parse command
my $cmd = shift @ARGV || 'list';

if ($cmd eq 'add') {
    add_todo(@ARGV);
} elsif ($cmd eq 'list' || $cmd eq 'ls') {
    list_todos(@ARGV);
} elsif ($cmd eq 'done') {
    mark_done(@ARGV);
} elsif ($cmd eq 'defer') {
    defer_todo(@ARGV);
} elsif ($cmd eq 'prioritize' || $cmd eq 'pri') {
    prioritize_todo(@ARGV);
} elsif ($cmd eq 'archive') {
    archive_completed();
} elsif ($cmd eq 'show') {
    show_todo(@ARGV);
} elsif ($cmd eq 'rm' || $cmd eq 'delete') {
    delete_todo(@ARGV);
} elsif ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
    show_help();
} else {
    die "Unknown command: $cmd\nRun 'bin/todo help' for usage.\n";
}

sub add_todo {
    my ($content, $priority) = @_;

    unless ($content) {
        die "Usage: bin/todo add \"<content>\" [priority]\n";
    }

    $priority ||= 'medium';
    unless ($priority =~ /^(critical|high|medium|low|deferred)$/) {
        die "Invalid priority: $priority\nValid: critical, high, medium, low, deferred\n";
    }

    my $todos = load_todos();

    # Generate unique ID
    my $id = generate_id();

    # Get current context
    my $branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null` || 'unknown';
    chomp $branch;

    my $todo = {
        id => $id,
        content => $content,
        priority => $priority,
        status => 'pending',
        created => time(),
        branch => $branch,
    };

    push @$todos, $todo;
    save_todos($todos);

    my $emoji = priority_emoji($priority);
    print "✅ Todo added: $emoji $content [$priority] ($id)\n";

    # Update status files
    system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
}

sub list_todos {
    my ($filter) = @_;

    my $todos = load_todos();

    # Filter by priority if specified
    if ($filter && $filter =~ /^(critical|high|medium|low|deferred|pending|in_progress)$/) {
        if ($filter =~ /^(pending|in_progress)$/) {
            $todos = [grep { $_->{status} eq $filter } @$todos];
        } else {
            $todos = [grep { $_->{priority} eq $filter } @$todos];
        }
    }

    # Sort by priority then created time
    my %priority_order = (critical => 0, high => 1, medium => 2, low => 3, deferred => 4);
    $todos = [sort {
        ($priority_order{$a->{priority}} <=> $priority_order{$b->{priority}}) ||
        ($a->{created} <=> $b->{created})
    } @$todos];

    if (@$todos == 0) {
        print "📭 No todos" . ($filter ? " matching '$filter'" : "") . "\n";
        return;
    }

    print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    print "TODOS" . ($filter ? " [$filter]" : "") . "\n";
    print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

    my $current_priority = '';
    for my $todo (@$todos) {
        # Print priority header
        if ($todo->{priority} ne $current_priority) {
            $current_priority = $todo->{priority};
            my $emoji = priority_emoji($current_priority);
            print "\n$emoji " . uc($current_priority) . ":\n";
        }

        my $status_icon = $todo->{status} eq 'in_progress' ? '🔄' : '⬜';
        my $age = format_age(time() - $todo->{created});

        print "  $status_icon $todo->{content}\n";
        print "     ID: $todo->{id} | Branch: $todo->{branch} | Age: $age\n";

        if ($todo->{blocked_by}) {
            print "     ⚠️  Blocked by: $todo->{blocked_by}\n";
        }
        if ($todo->{research_ref}) {
            print "     🔬 Research: $todo->{research_ref}\n";
        }
    }

    print "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    print scalar(@$todos) . " todo(s)\n";
}

sub mark_done {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/todo done <id>\n";
    }

    my $todos = load_todos();
    my $found = 0;

    for my $todo (@$todos) {
        if ($todo->{id} eq $id) {
            $todo->{status} = 'completed';
            $todo->{completed} = time();
            $found = 1;

            print "✅ Completed: $todo->{content}\n";

            # Suggest archiving if multiple completed
            my $completed_count = scalar(grep { $_->{status} eq 'completed' } @$todos);
            if ($completed_count >= 3) {
                print "💡 Tip: bin/todo archive  # Archive $completed_count completed todo(s)\n";
            }

            last;
        }
    }

    if ($found) {
        save_todos($todos);
        system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
    } else {
        die "❌ Todo not found: $id\n";
    }
}

sub defer_todo {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/todo defer <id>\n";
    }

    my $todos = load_todos();
    my $found = 0;

    for my $todo (@$todos) {
        if ($todo->{id} eq $id) {
            $todo->{priority} = 'deferred';
            $todo->{deferred_at} = time();
            $found = 1;

            print "⏸️  Deferred: $todo->{content}\n";
            last;
        }
    }

    if ($found) {
        save_todos($todos);
        system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
    } else {
        die "❌ Todo not found: $id\n";
    }
}

sub prioritize_todo {
    my ($id, $new_priority) = @_;

    unless ($id && $new_priority) {
        die "Usage: bin/todo prioritize <id> <priority>\n";
    }

    unless ($new_priority =~ /^(critical|high|medium|low|deferred)$/) {
        die "Invalid priority: $new_priority\nValid: critical, high, medium, low, deferred\n";
    }

    my $todos = load_todos();
    my $found = 0;

    for my $todo (@$todos) {
        if ($todo->{id} eq $id) {
            my $old = $todo->{priority};
            $todo->{priority} = $new_priority;
            $found = 1;

            my $emoji = priority_emoji($new_priority);
            print "$emoji Updated priority: $old → $new_priority\n";
            print "   $todo->{content}\n";
            last;
        }
    }

    if ($found) {
        save_todos($todos);
    } else {
        die "❌ Todo not found: $id\n";
    }
}

sub archive_completed {
    my $todos = load_todos();
    my @completed = grep { $_->{status} eq 'completed' } @$todos;
    my @active = grep { $_->{status} ne 'completed' } @$todos;

    if (@completed == 0) {
        print "📭 No completed todos to archive\n";
        return;
    }

    # Create archive file
    my $date = localtime->ymd;
    my $archive_file = "$ARCHIVE_DIR/$date.yaml";

    # Load existing archive if present
    my @archive_todos = ();
    if (-f $archive_file) {
        my $content = do { local (@ARGV, $/) = $archive_file; <> };
        @archive_todos = parse_yaml_todos($content);
    }

    # Add newly completed
    push @archive_todos, @completed;

    # Save archive
    save_todos(\@archive_todos, $archive_file);

    # Save active (without completed)
    save_todos(\@active);

    print "📦 Archived " . scalar(@completed) . " completed todo(s) to $archive_file\n";

    for my $todo (@completed) {
        my $duration = format_age($todo->{completed} - $todo->{created});
        print "   ✅ $todo->{content} (completed in $duration)\n";
    }
}

sub show_todo {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/todo show <id>\n";
    }

    my $todos = load_todos();

    for my $todo (@$todos) {
        if ($todo->{id} eq $id) {
            print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
            print "TODO: $todo->{id}\n";
            print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

            my $emoji = priority_emoji($todo->{priority});
            print "$emoji $todo->{content}\n\n";

            print "Priority:  $todo->{priority}\n";
            print "Status:    $todo->{status}\n";
            print "Branch:    $todo->{branch}\n";
            print "Created:   " . localtime($todo->{created})->datetime . "\n";
            print "Age:       " . format_age(time() - $todo->{created}) . "\n";

            if ($todo->{completed}) {
                print "Completed: " . localtime($todo->{completed})->datetime . "\n";
                print "Duration:  " . format_age($todo->{completed} - $todo->{created}) . "\n";
            }

            if ($todo->{blocked_by}) {
                print "\n⚠️  Blocked by: $todo->{blocked_by}\n";
            }

            if ($todo->{research_ref}) {
                print "\n🔬 Research: $todo->{research_ref}\n";
            }

            print "\n";
            return;
        }
    }

    die "❌ Todo not found: $id\n";
}

sub delete_todo {
    my ($id) = @_;

    unless ($id) {
        die "Usage: bin/todo rm <id>\n";
    }

    my $todos = load_todos();
    my $original_count = scalar(@$todos);

    $todos = [grep { $_->{id} ne $id } @$todos];

    if (scalar(@$todos) == $original_count) {
        die "❌ Todo not found: $id\n";
    }

    save_todos($todos);
    print "🗑️  Deleted todo: $id\n";

    system("$RealBin/update-status 2>/dev/null") if -x "$RealBin/update-status";
}

sub show_help {
    print <<'HELP';
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TODO - Persistent Task Management
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE:
  bin/todo <command> [args]

COMMANDS:
  add <content> [priority]    Add new todo (priority: critical|high|medium|low|deferred)
  list [filter]               List todos (filter: priority or status)
  done <id>                   Mark todo as completed
  defer <id>                  Defer todo (low priority)
  prioritize <id> <priority>  Change todo priority
  archive                     Archive completed todos
  show <id>                   Show todo details
  rm <id>                     Delete todo
  help                        Show this help

EXAMPLES:
  bin/todo add "Implement filesystem integration" high
  bin/todo list critical
  bin/todo done t-20251107-010000
  bin/todo defer t-20251107-010001
  bin/todo prioritize t-20251107-010002 critical
  bin/todo archive

PRIORITIES:
  🔴 critical  - Blocking work, must do now
  🟠 high      - Important, do soon
  🟡 medium    - Normal priority (default)
  🟢 low       - Nice to have
  ⚪ deferred  - Maybe later

FILES:
  .todos/active.yaml          Active todos (local only, gitignored)
  .todos/archive/YYYY-MM-DD   Archived completed todos

TOKEN SAVINGS:
  - Per session resume: ~500-1000 tokens (no re-explaining context)
  - Compound over 100 sessions: ~50k-100k tokens

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
HELP
}

# Helper functions

sub load_todos {
    my $file = shift || $ACTIVE_FILE;
    return [] unless -f $file;

    my $content = do { local (@ARGV, $/) = $file; <> };
    return parse_yaml_todos($content);
}

sub parse_yaml_todos {
    my ($content) = @_;

    my @todos;
    my $current = undef;

    for my $line (split /\n/, $content) {
        next if $line =~ /^#/ || $line =~ /^\s*$/;
        next if $line =~ /^todos:/;

        if ($line =~ /^\s*-\s+id:\s*(.+)/) {
            $current = { id => $1 };
            push @todos, $current;
        } elsif ($current && $line =~ /^\s+(\w+):\s*(.+)/) {
            my ($key, $val) = ($1, $2);
            $val =~ s/^["'](.*)["']$/$1/;  # Remove quotes
            $current->{$key} = $val;
        }
    }

    return \@todos;
}

sub save_todos {
    my ($todos, $file) = @_;
    $file ||= $ACTIVE_FILE;

    open my $fh, '>', $file or die "Cannot write $file: $!\n";

    print $fh "# Todos\n";
    print $fh "# Generated by bin/todo at " . localtime->datetime . "\n";
    print $fh "todos:\n";

    for my $todo (@$todos) {
        print $fh "  - id: $todo->{id}\n";
        print $fh "    content: \"$todo->{content}\"\n";
        print $fh "    priority: $todo->{priority}\n";
        print $fh "    status: $todo->{status}\n";
        print $fh "    created: $todo->{created}\n";
        print $fh "    branch: $todo->{branch}\n";

        print $fh "    completed: $todo->{completed}\n" if $todo->{completed};
        print $fh "    deferred_at: $todo->{deferred_at}\n" if $todo->{deferred_at};
        print $fh "    blocked_by: $todo->{blocked_by}\n" if $todo->{blocked_by};
        print $fh "    research_ref: $todo->{research_ref}\n" if $todo->{research_ref};
    }

    close $fh;
}

sub generate_id {
    my $t = localtime;
    return 't-' . $t->ymd('') . '-' . $t->hms('');
}

sub priority_emoji {
    my ($priority) = @_;
    return '🔴' if $priority eq 'critical';
    return '🟠' if $priority eq 'high';
    return '🟡' if $priority eq 'medium';
    return '🟢' if $priority eq 'low';
    return '⚪' if $priority eq 'deferred';
    return '❓';
}

sub format_age {
    my ($seconds) = @_;

    my $days = int($seconds / 86400);
    my $hours = int(($seconds % 86400) / 3600);
    my $mins = int(($seconds % 3600) / 60);

    return "${days}d ${hours}h" if $days > 0;
    return "${hours}h ${mins}m" if $hours > 0;
    return "${mins}m";
}
